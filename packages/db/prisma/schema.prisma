// Montra database schema.
//
// Design principles (see /FINANCIAL_ENGINE.md for the full write-up):
// 1. Every dollar amount is an integer number of cents. Never a float.
// 2. Balances are DERIVED, not stored redundantly. Account balances,
//    category "activity"/"available", and "available to budget" are all
//    computed from the transaction/assignment ledgers by the domain engine
//    (packages/domain), not cached columns here. The one exception is
//    Entitlement, which is a genuine piece of state, not a computation.
// 3. Money movement between budget categories is an append-only ledger
//    (Assignment), not a mutable counter, so every change is auditable.
// 4. Account starting balances are ordinary Transactions (payee
//    "Starting Balance"), so an account's balance always has exactly one
//    source of truth: "sum of its transactions."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & account security
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings          UserSettings?
  entitlement       Entitlement?
  budgets           Budget[]
  sessions          Session[]
  purchases         Purchase[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  budgetMemberships BudgetMember[] @relation("BudgetMemberUser")
  sentBudgetInvites BudgetMember[] @relation("BudgetMemberInvitedBy")
  ownedCategories   Category[]     @relation("CategoryOwner")

  @@map("users")
}

/// Opaque bearer session tokens. The cookie holds the raw token; only its
/// SHA-256 hash is persisted, so a database read never yields a usable
/// session (see apps/web/src/server/auth/session.ts).
model Session {
  id        String   @id // sha256(token) hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipHash    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model UserSettings {
  id                    String          @id @default(cuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency              String          @default("USD")
  dateFormat            String          @default("MM/DD/YYYY")
  firstDayOfMonth       Int             @default(1)
  theme                 ThemePreference @default(SYSTEM)
  notificationsEnabled  Boolean         @default(true)
  /// Per-user opt-in for the AI budgeting assistant, defaulting to off.
  /// The feature is also gated server-side on ANTHROPIC_API_KEY being set
  /// (see server/ai/index.ts) — both must be true before any Claude API
  /// call is ever made, so simply deploying this column never costs
  /// anything on its own.
  aiAssistantEnabled    Boolean         @default(false)
  onboardingCompletedAt DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("user_settings")
}

// ---------------------------------------------------------------------------
// Monetization: ads + one-time "Remove Ads" entitlement (see PHASE 10)
// ---------------------------------------------------------------------------

/// Server-side source of truth for ad-free status. Never trust a client
/// flag for this — the UI reads this via an authenticated API call.
model Entitlement {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adsRemoved Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("entitlements")
}

enum PaymentProvider {
  PLACEHOLDER // dev-only simulated provider
  STRIPE
  APPLE_IAP
  GOOGLE_PLAY
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Purchase {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  providerRef String? // external charge/transaction id
  product     String          @default("REMOVE_ADS")
  amountCents Int             @default(499)
  currency    String          @default("USD")
  status      PurchaseStatus  @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@map("purchases")
}

// ---------------------------------------------------------------------------
// Budgets
// ---------------------------------------------------------------------------

model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  currency   String   @default("USD")
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryGroups CategoryGroup[]
  categories     Category[]
  accounts       Account[]
  months         BudgetMonth[]
  payees         Payee[]
  transactions   Transaction[]
  goals          Goal[]
  recurring      RecurringTransaction[]
  imports        Import[]
  assignments    Assignment[]
  tags           Tag[]
  monthlyRecaps  MonthlyRecap[]
  members        BudgetMember[]

  @@index([userId])
  @@map("budgets")
}

enum BudgetMemberStatus {
  PENDING
  ACCEPTED
}

/// A collaborator (or pending invite) on a shared budget. `Budget.userId`
/// remains the single owner — the only account that can delete the
/// budget or manage its membership (see services/budgets.ts's
/// requireBudgetOwner); every accepted member otherwise has the same
/// read/write access as the owner (services/budgets.ts's
/// requireBudgetAccess), the same "real permissions" every other service
/// in this app checks before touching a budget's data.
model BudgetMember {
  id       String             @id @default(cuid())
  budgetId String
  budget   Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  /// Null while PENDING — set once the invited email accepts (see
  /// services/budget-members.ts's acceptInvite).
  userId   String?
  user     User?              @relation("BudgetMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  email    String
  status   BudgetMemberStatus @default(PENDING)

  invitedByUserId String
  invitedBy       User      @relation("BudgetMemberInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the invite link's token — same "never store the raw
  /// bearer value" principle as Session.id (see auth/session.ts). Rotated
  /// (a fresh token/hash) every time an invite is (re)sent.
  tokenHash       String    @unique
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?

  @@unique([budgetId, email])
  @@index([userId])
  @@map("budget_members")
}

/// A cached, plain-English monthly recap generated by the AI assistant
/// (see server/services/ai-assistant.ts) — stored so revisiting a month
/// already recapped doesn't silently re-trigger another paid API call;
/// regenerating is an explicit user action.
model MonthlyRecap {
  id        String   @id @default(cuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  month     DateTime
  text      String
  createdAt DateTime @default(now())

  @@unique([budgetId, month])
  @@map("monthly_recaps")
}

/// One row per calendar month a budget has ever touched. Created lazily.
model BudgetMonth {
  id       String   @id @default(cuid())
  budgetId String
  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  month    DateTime // normalized to the 1st of the month, UTC midnight

  categoryMonths CategoryMonth[]
  assignments    Assignment[]

  @@unique([budgetId, month])
  @@index([budgetId])
  @@map("budget_months")
}

model CategoryGroup {
  id         String   @id @default(cuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)
  isSystem   Boolean  @default(false) // e.g. auto-created "Credit Card Payments"
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  categories Category[]

  @@index([budgetId])
  @@map("category_groups")
}

model Category {
  id              String        @id @default(cuid())
  budgetId        String
  budget          Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  groupId         String
  group           CategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  sortOrder       Int           @default(0)
  isSystem        Boolean       @default(false) // system CC-payment categories are protected
  isArchived      Boolean       @default(false)
  /// Set only on the auto-generated "Payment: <Card>" category for a credit card account.
  linkedAccountId String?
  linkedAccount   Account?      @relation("CategoryLinkedAccount", fields: [linkedAccountId], references: [id])
  /// A private category is only visible to (and assignable by) the member
  /// who created it — every other member of a shared budget doesn't see
  /// it at all in their category lists/dropdowns (see
  /// services/budget.ts's listCategories/getMonthView filtering). Always
  /// false with a null owner on a single-user budget; meaningless without
  /// ownerUserId, so the two are set/cleared together.
  isPrivate       Boolean       @default(false)
  ownerUserId     String?
  owner           User?         @relation("CategoryOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  categoryMonths CategoryMonth[]
  assignments    Assignment[]
  splits         TransactionSplit[]
  goal           Goal?
  recurring      RecurringTransaction[]
  payeeDefaults  Payee[]                @relation("PayeeDefaultCategory")

  @@index([budgetId])
  @@index([groupId])
  @@map("categories")
}

/// Per-category-per-month state. `assignedCents` is a *cached, recomputable*
/// sum of this category's Assignment rows for this month — kept as a column
/// (rather than summed on every read) purely for query performance, and
/// always written inside the same DB transaction as the Assignment rows
/// that justify it. Activity and Available are never stored — see
/// packages/domain/src/budget-engine.ts.
model CategoryMonth {
  id            String      @id @default(cuid())
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  budgetMonthId String
  budgetMonth   BudgetMonth @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  assignedCents Int         @default(0)

  @@unique([categoryId, budgetMonthId])
  @@index([budgetMonthId])
  @@map("category_months")
}

enum AssignmentKind {
  ASSIGN // user directly assigned money to a category
  MOVE_FROM // money moved out to another category
  MOVE_TO // money moved in from another category
  CC_OFFSET // automatic credit-card spend offset (see FINANCIAL_ENGINE.md)
  ROLLOVER // automatic negative-rollover correction, if ever needed
}

/// Append-only ledger of every change to a category's assigned amount.
/// CategoryMonth.assignedCents is always SUM(Assignment.amountCents) for
/// that (categoryId, budgetMonthId) pair.
model Assignment {
  id                  String         @id @default(cuid())
  categoryId          String
  category            Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  budgetMonthId       String
  budgetMonth         BudgetMonth    @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  budgetId            String
  budget              Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  amountCents         Int // signed delta
  kind                AssignmentKind
  memo                String?
  /// Links the two legs of a "move money" operation or a CC offset pair.
  pairedWithId        String?
  /// Set only for CC_OFFSET rows: the purchase/refund transaction that
  /// caused this automatic move, so deleting/editing that transaction can
  /// precisely reverse it instead of leaving orphaned envelope math.
  sourceTransactionId String?
  sourceTransaction   Transaction?   @relation(fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  createdAt           DateTime       @default(now())

  @@index([categoryId, budgetMonthId])
  @@index([budgetId])
  @@index([sourceTransactionId])
  @@map("assignments")
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  LOAN
  OTHER_ASSET
  OTHER_LIABILITY
}

model Account {
  id          String      @id @default(cuid())
  budgetId    String
  budget      Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name        String
  type        AccountType
  institution String?
  notes       String?
  isClosed    Boolean     @default(false)
  /// On-budget accounts feed "Available to Budget"; off-budget (tracking)
  /// accounts are included in net worth only.
  onBudget    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  transactions         Transaction[]          @relation("AccountTransactions")
  transferTransactions Transaction[]          @relation("TransferAccount")
  debt                 Debt?
  reconciliations      Reconciliation[]
  recurring            RecurringTransaction[]
  imports              Import[]
  goals                Goal[]
  linkedCategories     Category[]             @relation("CategoryLinkedAccount")
  holdings             Holding[]

  @@index([budgetId])
  @@map("accounts")
}

/// A manually-tracked investment position (e.g. a stock, fund, or crypto
/// position) belonging to an INVESTMENT account — informational only. Per
/// this schema's own rule #2, an account's balance always comes from its
/// transactions; holdings never substitute for that. Updating a holding's
/// price/quantity can prompt the user to log a matching adjustment
/// transaction (the same reconciliation pattern already used elsewhere),
/// but the holding rows themselves are never summed into a balance.
model Holding {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String
  symbol            String?
  /// A share/unit count, not a money amount — unlike every Cents field in
  /// this schema, ordinary floating point is precise enough for a
  /// manually-entered position size.
  quantity          Float
  /// Total amount originally paid for this position, if known. Optional —
  /// gain/loss simply isn't shown when absent.
  costBasisCents    Int?
  currentPriceCents Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  snapshots HoldingSnapshot[]

  @@index([accountId])
  @@map("holdings")
}

/// A price/quantity data point recorded every time a Holding is updated —
/// the only way this app has "performance over time" for a position,
/// since there's no live market-data feed (see ARCHITECTURE.md).
model HoldingSnapshot {
  id         String   @id @default(cuid())
  holdingId  String
  holding    Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  quantity   Float
  priceCents Int
  recordedAt DateTime @default(now())

  @@index([holdingId, recordedAt])
  @@map("holding_snapshots")
}

model Debt {
  id                   String   @id @default(cuid())
  accountId            String   @unique
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  originalBalanceCents Int
  interestRateBps      Int      @default(0) // basis points, e.g. 1999 = 19.99%
  minimumPaymentCents  Int      @default(0)
  dueDayOfMonth        Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("debts")
}

// ---------------------------------------------------------------------------
// Payees
// ---------------------------------------------------------------------------

model Payee {
  id                String    @id @default(cuid())
  budgetId          String
  budget            Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name              String
  defaultCategoryId String?
  defaultCategory   Category? @relation("PayeeDefaultCategory", fields: [defaultCategoryId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions Transaction[]
  recurring    RecurringTransaction[]
  importRows   ImportTransaction[]

  @@unique([budgetId, name])
  @@index([budgetId])
  @@map("payees")
}

// ---------------------------------------------------------------------------
// Transactions
// ---------------------------------------------------------------------------

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REFUND
  CREDIT_CARD_PAYMENT
}

enum ClearedStatus {
  UNCLEARED
  CLEARED
  RECONCILED
}

model Transaction {
  id          String          @id @default(cuid())
  budgetId    String
  budget      Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account         @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  payeeId     String?
  payee       Payee?          @relation(fields: [payeeId], references: [id])
  date        DateTime
  amountCents Int // signed: outflow negative, inflow positive
  memo        String?
  type        TransactionType
  cleared     ClearedStatus   @default(UNCLEARED)
  isSplit     Boolean         @default(false)

  /// Set when this transaction was materialized from a recurring series
  /// (see server/services/recurring.ts's materializeDueRecurring) — lets a
  /// series' progress-to-date (e.g. a multi-installment bill's amount
  /// paid so far) be computed by summing its actual linked transactions,
  /// not just assumed from the schedule. Null for anything entered by
  /// hand or imported. SetNull (not Cascade) so deleting the recurring
  /// series never deletes the real transactions it already created.
  sourceRecurringId String?
  sourceRecurring   RecurringTransaction? @relation("RecurringSource", fields: [sourceRecurringId], references: [id], onDelete: SetNull)

  /// For TRANSFER transactions: the other account, and the linked mirror row.
  transferAccountId String?
  transferAccount   Account?     @relation("TransferAccount", fields: [transferAccountId], references: [id])
  transferPeerId    String?      @unique
  transferPeer      Transaction? @relation("TransferPeer", fields: [transferPeerId], references: [id])
  transferPeerOf    Transaction? @relation("TransferPeer")

  importRowId String?            @unique
  importRow   ImportTransaction? @relation(fields: [importRowId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  splits                TransactionSplit[]
  reconciliationAdjusts Reconciliation[]
  ccOffsetAssignments   Assignment[]
  tags                  TransactionTag[]

  @@index([budgetId, date])
  @@index([accountId, date])
  @@index([payeeId])
  @@index([sourceRecurringId])
  @@map("transactions")
}

/// Free-form, budget-scoped labels for cross-category grouping (e.g.
/// "vacation," "deductible") — independent of the category hierarchy,
/// which is about *where the money is budgeted*, not ad-hoc grouping.
model Tag {
  id        String   @id @default(cuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  transactions TransactionTag[]

  @@unique([budgetId, name])
  @@index([budgetId])
  @@map("tags")
}

/// Many-to-many join: a transaction can carry several tags, a tag can
/// apply to many transactions.
model TransactionTag {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
}

/// Every transaction has >=1 split. Non-split transactions simply have one
/// split whose amount equals the transaction total — this keeps the engine
/// (and category Activity queries) working off one code path.
model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id])
  amountCents   Int
  memo          String?

  @@index([transactionId])
  @@index([categoryId])
  @@map("transaction_splits")
}

// ---------------------------------------------------------------------------
// Recurring transactions
// ---------------------------------------------------------------------------

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  EVERY_N_MONTHS
  YEARLY
  CUSTOM
}

model RecurringTransaction {
  id                 String              @id @default(cuid())
  budgetId           String
  budget             Budget              @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payeeId            String?
  payee              Payee?              @relation(fields: [payeeId], references: [id])
  categoryId         String?
  category           Category?           @relation(fields: [categoryId], references: [id])
  amountCents        Int
  memo               String?
  type               TransactionType
  frequency          RecurrenceFrequency
  intervalCount      Int                 @default(1) // e.g. every N months/weeks
  startDate          DateTime
  endDate            DateTime?
  occurrencesLimit   Int?
  occurrencesCreated Int                 @default(0)
  nextOccurrenceDate DateTime
  reminderDaysBefore Int?
  autoCreate         Boolean             @default(false)
  isActive           Boolean             @default(true)
  /// "Would I still pay for this?" review flag (subscriptions especially) —
  /// purely a marker the user sets by hand, rolled up into an annualized
  /// savings estimate; flagging something here never changes what it does.
  flaggedToCancel    Boolean             @default(false)
  /// Optional target total for a bounded series — a one-time bill paid in
  /// installments, or a fixed number of payments toward a set amount.
  /// "Amount paid so far" is derived from `transactions` (the series'
  /// actual materialized occurrences), never stored redundantly. Null for
  /// an open-ended series (most bills/income), where "total" has no
  /// meaning.
  totalAmountCents   Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  transactions Transaction[] @relation("RecurringSource")

  @@index([budgetId])
  @@index([nextOccurrenceDate])
  @@map("recurring_transactions")
}

// ---------------------------------------------------------------------------
// Goals
// ---------------------------------------------------------------------------

enum GoalType {
  TARGET_BALANCE
  MONTHLY_CONTRIBUTION
  TARGET_DATE
  DEBT_PAYOFF
}

enum GoalPriority {
  HIGH
  MEDIUM
  LOW
}

model Goal {
  id                       String       @id @default(cuid())
  budgetId                 String
  budget                   Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId               String?      @unique
  category                 Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Set for DEBT_PAYOFF goals: the debt-carrying account being paid down.
  accountId                String?
  account                  Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                     String
  type                     GoalType
  /// Purely a display/sort hint plus an input to the feasibility check
  /// (services/goals.ts) — never changes how a goal's own progress is
  /// computed.
  priority                 GoalPriority @default(MEDIUM)
  targetAmountCents        Int?
  targetDate               DateTime?
  monthlyContributionCents Int?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([budgetId])
  @@index([accountId])
  @@map("goals")
}

// ---------------------------------------------------------------------------
// Reconciliation
// ---------------------------------------------------------------------------

model Reconciliation {
  id                      String       @id @default(cuid())
  accountId               String
  account                 Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  statementDate           DateTime
  statementBalanceCents   Int
  previousBalanceCents    Int
  adjustmentTransactionId String?      @unique
  adjustmentTransaction   Transaction? @relation(fields: [adjustmentTransactionId], references: [id])
  createdAt               DateTime     @default(now())

  @@index([accountId])
  @@map("reconciliations")
}

// ---------------------------------------------------------------------------
// CSV import
// ---------------------------------------------------------------------------

enum ImportStatus {
  PENDING
  COMMITTED
  CANCELLED
}

model Import {
  id          String       @id @default(cuid())
  budgetId    String
  budget      Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filename    String
  status      ImportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  committedAt DateTime?

  rows ImportTransaction[]

  @@index([budgetId])
  @@map("imports")
}

model ImportTransaction {
  id                       String   @id @default(cuid())
  importId                 String
  import                   Import   @relation(fields: [importId], references: [id], onDelete: Cascade)
  rawDate                  DateTime
  rawPayeeText             String
  rawAmountCents           Int
  rawMemo                  String?
  matchedPayeeId           String?
  matchedPayee             Payee?   @relation(fields: [matchedPayeeId], references: [id])
  matchedCategoryId        String?
  isDuplicate              Boolean  @default(false)
  duplicateOfTransactionId String?
  willImport               Boolean  @default(true)
  createdAt                DateTime @default(now())

  createdTransaction Transaction?

  @@index([importId])
  @@map("import_transactions")
}

// ---------------------------------------------------------------------------
// Notifications & audit
// ---------------------------------------------------------------------------

enum NotificationType {
  UPCOMING_BILL
  OVERSPENDING
  GOAL_MILESTONE
  RECURRING_TRANSACTION
  RECONCILIATION_REMINDER
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  body              String
  isRead            Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String // e.g. "transaction.created"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}
