# Copy to packages/db/.env for local development.
#
# Prisma's CLI (migrate, generate, studio — and apps/web's build script,
# which runs `prisma migrate deploy` from here) discovers its DATABASE_URL
# via a .env file colocated with this package, not via apps/web/.env.local
# (that one's loaded by Next.js, for the running app itself). Keep both
# files' DATABASE_URL in sync for local dev — see the root README.
DATABASE_URL="postgresql://montra:montra_dev_pw@localhost:5432/montra_dev?schema=public"
