require "base64"
require "shellwords"
require "tempfile"

default_platform(:ios)

platform :ios do
  desc "Build the native shell and upload it to TestFlight (internal testing)."
  lane :beta do
    # All of these come from GitHub Actions secrets — see
    # docs/ios-testflight-setup.md for exactly how to generate each one.
    # Nothing here should ever be hardcoded or committed.
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    # `app_store_connect_api_key` below authenticates *fastlane's own*
    # App Store Connect API calls (e.g. the TestFlight upload), but
    # xcodebuild's automatic provisioning-profile creation
    # (`-allowProvisioningUpdates` on build_app, further down) runs as a
    # separate process and does not inherit that session — it needs the
    # same key hand it directly as a file via the three
    # -authenticationKey... flags. So write it out once and pass that one
    # file to both.
    api_key_file = Tempfile.new(["app_store_connect_api_key", ".p8"])
    api_key_file.write(Base64.decode64(ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT")))
    api_key_file.close

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: api_key_file.path,
    )

    # Automatic signing: Xcode + the App Store Connect API key create/renew
    # the distribution certificate and provisioning profile on demand, so
    # there is no separate certificates repo (fastlane match) to maintain
    # for this app.
    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: team_id,
      path: "ios/App/App.xcodeproj",
    )

    # TestFlight requires a strictly increasing build number per version.
    # The CI run number is a simple, always-unique, always-increasing
    # source for this that needs no local state.
    increment_build_number(
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", "1"),
      xcodeproj: "ios/App/App.xcodeproj",
    )

    build_app(
      workspace: nil,
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{api_key_file.path.shellescape}",
        "-authenticationKeyID #{key_id.shellescape}",
        "-authenticationKeyIssuerID #{issuer_id.shellescape}",
      ].join(" "),
      output_directory: "ios/build",
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false, # internal testers only until the app is production-ready
    )
  ensure
    api_key_file&.unlink
  end
end
