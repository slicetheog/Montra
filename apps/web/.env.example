# Copy this file to .env.local for local development.
# See DEPLOYMENT.md for a full explanation of each variable and how to
# provision them for staging/production.

# --- Database (required) -----------------------------------------------
# PostgreSQL connection string. Prisma reads this directly.
DATABASE_URL="postgresql://montra:montra_dev_pw@localhost:5432/montra_dev?schema=public"

# --- App URL (required) --------------------------------------------------
# Used for absolute links in emails/exports and CORS/CSRF origin checks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Ad provider abstraction ---------------------------------------------
# "placeholder" renders a clearly-labeled house ad and requires no keys —
# safe default for local dev. Set to "adsense" in production once you have
# an AdSense account, and provide NEXT_PUBLIC_ADSENSE_CLIENT_ID below.
NEXT_PUBLIC_AD_PROVIDER="placeholder"
# NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-xxxxxxxxxxxxxxxx"

# --- Payment provider abstraction (Remove Ads Forever, $4.99 one-time) --
# "placeholder" simulates a successful purchase instantly with no real
# charge — safe default for local dev, never for production. Set to
# "stripe" in production and provide the three Stripe variables below.
PAYMENT_PROVIDER="placeholder"
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_REMOVE_ADS_PRICE_ID="price_..."
