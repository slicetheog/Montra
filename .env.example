# Copy to apps/web/.env.local for local development.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://montra:montra_dev_pw@localhost:5432/montra_dev?schema=public"

# 32+ byte random secret used to sign/derive session-related material.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Ad provider: "placeholder" (default, dev) | "adsense" | "custom"
NEXT_PUBLIC_AD_PROVIDER="placeholder"

# Payment provider: "placeholder" (default, dev/demo) | "stripe"
PAYMENT_PROVIDER="placeholder"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_REMOVE_ADS_PRICE_ID=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
